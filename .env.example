# Paste YOUR values here in .env.local (never commit that file).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_SERVICE_ROLE_KEY
APP_URL=http://localhost:3000
NEXT_PUBLIC_STATUS_PAGE_URL=

# Do not enable live charging until testing and authorisation are complete.
GOCARDLESS_ENV=sandbox
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
ALLOW_LIVE_COLLECTIONS=false

RESEND_API_KEY=
RESEND_FROM=Little Explorers <hello@YOUR_VERIFIED_DOMAIN>

# Protect the scheduled invoice endpoint; generate a long random secret.
CRON_SECRET=
INVOICE_AUTO_ISSUE=false
HEALTH_CHECK_SECRET=

# Only displayed to authorised, approved families.
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
BANK_REFERENCE_PREFIX=LE
